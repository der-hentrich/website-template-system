---
// @ts-ignore
import SiteTemplate from '@siteTemplate';
// @ts-ignore
import data from '@siteData/data.json';

type Lang = 'es' | 'en';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;

if (import.meta.env.PROD && data.demo !== true && !Astro.site) {
    throw new Error('SITE_URL fehlt für den produktiven Build. Setze SITE_URL auf die vollständige öffentliche Domain, z. B. https://example.com.');
}

const imageModules = import.meta.glob('@siteData/images/*', {
    eager: true,
    query: '?url',
    import: 'default'
}) as Record<string, string>;

const images = Object.fromEntries(
    Object.entries(imageModules).map(([path, url]) => [path.split('/').pop(), url])
);

function resolveLocalized(value: unknown): unknown {
    if (Array.isArray(value)) {
        return value.map(resolveLocalized);
    }

    if (value !== null && typeof value === 'object') {
        const object = value as Record<string, unknown>;
        const keys = Object.keys(object);

        if (keys.length === 2 && keys.includes('es') && keys.includes('en')) {
            return resolveLocalized(object[lang]);
        }

        return Object.fromEntries(
            Object.entries(object).map(([key, item]) => [key, resolveLocalized(item)])
        );
    }

    return value;
}

function resolveImages(value: unknown): unknown {
    if (Array.isArray(value)) {
        return value.map(resolveImages);
    }

    if (value !== null && typeof value === 'object') {
        return Object.fromEntries(
            Object.entries(value as Record<string, unknown>).map(([key, item]) => [key, resolveImages(item)])
        );
    }

    if (typeof value === 'string' && value.startsWith('images/')) {
        const filename = value.substring('images/'.length);
        const url = images[filename];

        if (!url) {
            throw new Error(`Bild nicht gefunden: ${value}`);
        }

        return url;
    }

    return value;
}

const localizedData = resolveLocalized(data);
const resolvedData = resolveImages(localizedData);
---

<SiteTemplate data={resolvedData} lang={lang} />