---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="mx-auto max-w-3xl px-6 py-16">
		<h1 class="mb-8 text-4xl font-bold text-slate-900">Astro + Tailwind + Preline Test</h1>

		<button class="mb-10 rounded-lg bg-emerald-600 px-5 py-3 font-semibold text-white hover:bg-emerald-700">
			Tailwind funktioniert
		</button>

		<div class="hs-accordion-group">
			<div class="hs-accordion active" id="test-accordion">
				<button class="hs-accordion-toggle flex w-full items-center gap-x-3 rounded-lg py-3 text-left font-semibold text-slate-900" aria-expanded="true" aria-controls="test-accordion-content">
					Preline Accordion
				</button>

				<div id="test-accordion-content" class="hs-accordion-content w-full overflow-hidden transition-[height] duration-300" role="region" aria-labelledby="test-accordion">
					<p class="pb-4 text-slate-600">
						Wenn sich dieser Bereich per Klick ein- und ausklappen lässt, funktioniert auch Preline.
					</p>
				</div>
			</div>
		</div>
	</main>
</Layout>