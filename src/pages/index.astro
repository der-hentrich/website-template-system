---
import SiteTemplate from '@siteTemplate';
import data from '@siteData/data.json';

const imageModules = import.meta.glob('@siteData/images/*', {
	eager: true,
	query: '?url',
	import: 'default'
}) as Record<string, string>;

const images = Object.fromEntries(
	Object.entries(imageModules).map(([path, url]) => [path.split('/').pop(), url])
);

function resolveImages(value: unknown): unknown {
	if (Array.isArray(value)) {
		return value.map(resolveImages);
	}

	if (value !== null && typeof value === 'object') {
		return Object.fromEntries(
			Object.entries(value as Record<string, unknown>).map(([key, item]) => [key, resolveImages(item)])
		);
	}

	if (typeof value === 'string' && value.startsWith('images/')) {
		const filename = value.substring('images/'.length);
		const url = images[filename];

		if (!url) {
			throw new Error(`Bild nicht gefunden: ${value}`);
		}

		return url;
	}

	return value;
}

const resolvedData = resolveImages(data);
---

<SiteTemplate data={resolvedData} />