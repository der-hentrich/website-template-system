---
import Site from '../site/Site.astro';

export function getStaticPaths() {
    return [
        { params: { path: 'es' }, props: { lang: 'es' } },
        { params: { path: 'en' }, props: { lang: 'en' } }
    ];
}

interface Props {
    lang: 'es' | 'en';
}

const { lang } = Astro.props;
---

<Site lang={lang} />