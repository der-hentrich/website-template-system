---
import Layout from '../../site/Layout.astro';
import Navbar from './sections/Navbar.astro';
import Hero from './sections/Hero.astro';
import Intro from './sections/Intro.astro';
import Rooms from './sections/Rooms.astro';
import Amenities from './sections/Amenities.astro';
import GoogleRating from './sections/GoogleRating.astro';
import Gallery from './sections/Gallery.astro';
import Location from './sections/Location.astro';
import Contact from './sections/Contact.astro';
import Footer from './sections/Footer.astro';

interface Props {
    data: any;
    lang: 'es' | 'en';
}

const { data, lang } = Astro.props;
const { hotel } = data;
const isEnglish = lang === 'en';
const isDemo = data.demo === true;
const whatsappNumber = hotel.whatsapp.replace(/\D/g, '');
const getWhatsAppHref = (message?: string) => message ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}` : `https://wa.me/${whatsappNumber}`;
const locationLabel = `${hotel.region}, Colombia`;
const languageHref = isEnglish ? '/' : '/en/';
const seoTitle = data.seo?.title ?? `${hotel.name} | ${isEnglish ? 'Accommodation in' : 'Alojamiento en'} ${hotel.location}`;
const seoDescription = data.seo?.description ?? data.hero.description;
const navigation = isEnglish ? [
    { label: 'Rooms', href: '#rooms-section' },
    { label: 'Services', href: '#amenities-section' },
    ...(data.intro ? [{ label: 'About us', href: '#about-section' }] : []),
    { label: 'Gallery', href: '#gallery-section' },
    { label: 'Location', href: '#location-section' },
    { label: 'Contact', href: '#contact-section' }
] : [
    { label: 'Habitaciones', href: '#rooms-section' },
    { label: 'Servicios', href: '#amenities-section' },
    ...(data.intro ? [{ label: 'Nosotros', href: '#about-section' }] : []),
    { label: 'Galería', href: '#gallery-section' },
    { label: 'Ubicación', href: '#location-section' },
    { label: 'Contacto', href: '#contact-section' }
];
const heroMetas = [
    { icon: 'bed', text: isEnglish ? `${hotel.roomCount} rooms` : `${hotel.roomCount} habitaciones` },
    ...(data.hero.metas ?? []),
    { icon: 'verified', text: isEnglish ? 'Direct booking • No commissions' : 'Reserva directa • Sin comisiones' }
];
const rooms = data.rooms.rooms.map((room: any) => ({
    ...room,
    lang,
    whatsappHref: getWhatsAppHref(room.whatsappText)
}));
const demoRoomsNote = isDemo ? (isEnglish ? 'Sample room categories for this demonstration' : 'Categorías de habitaciones de ejemplo para esta demostración') : undefined;
const demoFooterNote = isDemo ? (isEnglish ? 'Commercial demonstration website – Professional Website by El Hentrich' : 'Sitio web de demostración comercial – Página Web Profesional de El Hentrich') : undefined;
const rntCertificateHref = '/rnt.pdf';
---

<Layout lang={lang} title={seoTitle} description={seoDescription} noIndex={isDemo}>
    <Navbar name={hotel.name} location={hotel.location} items={navigation} whatsappHref={getWhatsAppHref(data.navbar?.whatsappText)} lang={lang} languageHref={languageHref} />

    <main class="min-h-[calc(100vh-80px)] w-full bg-surface-container-low pt-20">
        <div class="flex w-full flex-col">
            <Hero {...data.hero} lang={lang} imageLocation={locationLabel} whatsappHref={getWhatsAppHref(data.hero.whatsappText)} rating={data.googleRating?.value} reviewCount={data.googleRating?.reviewCount} metas={heroMetas} />
            {data.intro && <Intro {...data.intro} />}
            <Rooms {...data.rooms} lang={lang} rooms={rooms} note={demoRoomsNote} />
            <Amenities {...data.amenities} lang={lang} />
            {data.googleRating && <GoogleRating {...data.googleRating} lang={lang} roomCount={hotel.roomCount} location={hotel.location} />}
            <Gallery {...data.gallery} lang={lang} />
            <Location {...data.location} lang={lang} location={hotel.location} region={hotel.region} hotelName={hotel.name} address={hotel.address} whatsappHref={getWhatsAppHref(data.location.whatsappText)} />
            <Contact lang={lang} name={hotel.name} location={hotel.location} region={hotel.region} roomCount={hotel.roomCount} phone={hotel.whatsapp} whatsappHref={getWhatsAppHref(data.contact?.whatsappText)} />
        </div>
    </main>

    <Footer lang={lang} name={hotel.name} address={hotel.address} roomCount={hotel.roomCount} rnt={hotel.rnt} rntCertificateHref={rntCertificateHref} items={navigation} phone={hotel.whatsapp} whatsappHref={getWhatsAppHref()} region={hotel.region} note={demoFooterNote} />
</Layout>
