---
import type { ImageMetadata } from 'astro';
import Button from '../../../components/Button.astro';
import GalleryItem from '../../../components/GalleryItem.astro';
import SectionHeader from '../../../components/SectionHeader.astro';

interface Filter { key: string; label: string; }
interface GalleryItem { image: ImageMetadata; imageAlt: string; category: string; eyebrow: string; title: string; description: string; }
interface Props { eyebrow: string; title: string; description: string; filters: Filter[]; items: GalleryItem[]; instagramHref: string; instagramLabel: string; }
const { eyebrow, title, description, filters, items, instagramHref, instagramLabel } = Astro.props;
---

<section class="w-full bg-surface py-3xl lg:py-4xl" id="galeria">
    <div class="mx-auto max-w-[var(--container-site)] px-base sm:px-lg">
        <div class="mx-auto max-w-[680px] text-center"><SectionHeader eyebrow={eyebrow} title={title} description={description} width="narrow" /></div>
        <div class="mb-xl flex flex-wrap items-center justify-center gap-sm" id="nail-gallery-filters">
            {filters.map((filter, index) => <Button class="nail-gallery-filter" variant="filter" size="xs" dataCategory={filter.key} pressed={index === 0}>{filter.label}</Button>)}
        </div>
        <div class="grid grid-cols-1 gap-lg md:grid-cols-2 lg:grid-cols-3" id="nail-gallery-items">
            {items.map((item) => <GalleryItem {...item} variant="editorial" />)}
        </div>
        <div class="mx-auto mt-lg flex max-w-gallery-cta justify-center">
            <Button class="max-w-full whitespace-normal text-center sm:whitespace-nowrap" variant="secondary" size="content" href={instagramHref} target="_blank" rel="noopener noreferrer" icon="photo_camera">{instagramLabel}</Button>
        </div>
    </div>
</section>

<script>
    const galleryFilters = document.querySelectorAll<HTMLButtonElement>('.nail-gallery-filter');
    const galleryItems = document.querySelectorAll<HTMLElement>('#nail-gallery-items .gallery-item');
    galleryFilters.forEach((button) => button.addEventListener('click', () => {
        const category = button.dataset.category;
        galleryFilters.forEach((filter) => {
            const active = filter === button;
            filter.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        galleryItems.forEach((item) => item.hidden = category !== 'all' && item.dataset.category !== category);
    }));
</script>
