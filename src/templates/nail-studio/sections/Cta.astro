---
import Button from '../../../components/Button.astro';
import Card from '../../../components/Card.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
interface Props { eyebrow: string; title: string; description: string; buttonLabel: string; whatsappHref: string; }
const { eyebrow, title, description, buttonLabel, whatsappHref } = Astro.props;
---

<section class="w-full bg-surface px-base py-3xl sm:px-lg">
    <Card variant="primary" radius="3xl" shadow="none" padding="none" class="mx-auto flex max-w-[var(--container-site)] flex-col items-center px-lg py-2xl text-center lg:py-3xl">
        <div class="mx-auto max-w-[680px]"><SectionHeader eyebrow={eyebrow} title={title} description={description} width="narrow" badgeVariant="dark" tone="inverse" spacing="compact" /></div>
        <Button variant="whatsapp" size="xl" href={whatsappHref} target="_blank" rel="noopener noreferrer">{buttonLabel}</Button>
    </Card>
</section>
