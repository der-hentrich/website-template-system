---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';

interface Feature { icon: string; title: string; description: string; }
interface Props { image: ImageMetadata; imageAlt: string; imageBadge: string; eyebrow: string; title: string; description: string; features: Feature[]; }
const { image, imageAlt, imageBadge, eyebrow, title, description, features } = Astro.props;
---

<section class="w-full bg-surface-alt py-3xl lg:py-4xl" id="nosotros">
    <div class="mx-auto grid max-w-[var(--container-site)] grid-cols-1 items-center gap-2xl px-base sm:px-lg lg:grid-cols-12">
        <div class="relative lg:col-span-6">
            <div class="relative aspect-[4/5] overflow-hidden rounded-ui-2xl bg-surface-variant"><Image class="h-full w-full object-cover" src={image} alt={imageAlt} /><span class="absolute left-6 top-6 rounded-full bg-surface/90 px-base py-sm font-body text-[12px] font-bold text-primary shadow-sm backdrop-blur-md">{imageBadge}</span></div>
        </div>
        <div class="flex flex-col lg:col-span-6">
            <span class="font-body text-[12px] font-semibold uppercase tracking-[0.12em] text-primary">{eyebrow}</span>
            <h2 class="mt-xs font-heading text-section-title text-text-primary">{title}</h2>
            <p class="mt-sm font-body text-body text-text-secondary">{description}</p>
            <div class="mt-lg grid grid-cols-1 gap-base sm:grid-cols-2">
                {features.map((feature) => <article class="rounded-ui-lg border border-primary/10 bg-surface p-base"><span class="mb-sm flex h-10 w-10 items-center justify-center rounded-full bg-accent-soft"><Icon name={feature.icon} size="md" tone="primary" /></span><h3 class="font-heading text-[18px] font-semibold text-text-primary">{feature.title}</h3><p class="mt-xs font-body text-[13px] leading-relaxed text-text-secondary">{feature.description}</p></article>)}
            </div>
        </div>
    </div>
</section>
