---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import AmenityCard from '../../../components/AmenityCard.astro';
import Badge from '../../../components/Badge.astro';
import Card from '../../../components/Card.astro';
import SectionHeader from '../../../components/SectionHeader.astro';

interface Feature { icon: string; title: string; description: string; }
interface Props { image: ImageMetadata; imageAlt: string; imageBadge: string; eyebrow: string; title: string; description: string; features: Feature[]; }
const { image, imageAlt, imageBadge, eyebrow, title, description, features } = Astro.props;
---

<section class="w-full bg-surface-alt py-3xl lg:py-4xl" id="nosotros">
    <div class="mx-auto grid max-w-[var(--container-site)] grid-cols-1 items-center gap-2xl px-base sm:px-lg lg:grid-cols-12">
        <div class="relative lg:col-span-6">
            <Card variant="media" radius="2xl" shadow="md" padding="none" overflow="hidden" class="relative aspect-[4/5]">
                <Image class="h-full w-full object-cover" src={image} alt={imageAlt} />
                <div class="absolute left-6 top-6"><Badge variant="overlay" icon="location_on" iconTone="primary">{imageBadge}</Badge></div>
            </Card>
        </div>
        <div class="flex flex-col lg:col-span-6">
            <SectionHeader eyebrow={eyebrow} title={title} description={description} width="narrow" badgeVariant="soft" />
            <div class="grid grid-cols-1 gap-base sm:grid-cols-2">
                {features.map((feature) => <AmenityCard {...feature} density="compact" surface="bright" />)}
            </div>
        </div>
    </div>
</section>
