---
import Button from '../../../components/Button.astro';
import Badge from '../../../components/Badge.astro';

interface Props { label: string; ariaLabel: string; whatsappHref: string; }
const { label, ariaLabel, whatsappHref } = Astro.props;
---

<div class="fixed bottom-5 right-5 z-40 flex items-center gap-sm">
    <span class="hidden md:block"><Badge variant="surface">{label}</Badge></span>
    <Button variant="whatsapp" size="xl" shape="circle" href={whatsappHref} target="_blank" rel="noopener noreferrer" ariaLabel={ariaLabel} />
</div>
