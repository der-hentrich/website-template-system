---
interface Props { label: string; ariaLabel: string; whatsappHref: string; }
const { label, ariaLabel, whatsappHref } = Astro.props;
---

<div class="fixed bottom-5 right-5 z-40 flex items-center gap-sm">
    <span class="hidden rounded-full bg-surface-bright px-md py-sm font-body text-[12px] font-semibold text-text-primary shadow-lg md:block">{label}</span>
    <a class="flex h-14 w-14 items-center justify-center rounded-full bg-whatsapp text-on-whatsapp shadow-xl transition-transform hover:scale-105 active:scale-95" href={whatsappHref} target="_blank" rel="noopener noreferrer" aria-label={ariaLabel}>
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.84 9.84 0 0 0-8.43 14.91L2 22l5.22-1.57A9.86 9.86 0 1 0 12.04 2Zm0 17.75a7.86 7.86 0 0 1-4.01-1.1l-.29-.17-3.1.93.96-3.02-.19-.31a7.83 7.83 0 1 1 6.63 3.67Zm4.3-5.87c-.24-.12-1.4-.69-1.62-.77-.22-.08-.38-.12-.54.12-.16.24-.62.77-.76.93-.14.16-.28.18-.52.06-.24-.12-1-.37-1.91-1.18a7.18 7.18 0 0 1-1.32-1.64c-.14-.24-.01-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.19-.47-.39-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.1 3.62.57.25 1.02.39 1.37.5.58.18 1.1.16 1.51.1.46-.07 1.4-.57 1.6-1.12.2-.55.2-1.02.14-1.12-.06-.1-.22-.16-.46-.28Z" /></svg>
    </a>
</div>
