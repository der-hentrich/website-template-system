---
import Badge from '../components/Badge.astro';
import Rating from '../components/Rating.astro';
import StatCard from '../components/StatCard.astro';

interface Stat {
    icon: string;
    title: string;
    description: string;
}

interface Props {
    value: number;
    reviewCount: number;
    roomCount: number;
    location: string;
    description?: string;
    stats?: Stat[];
    eyebrow?: string;
}

const { value, reviewCount, roomCount, location, description = 'Calificación pública confirmada en el Perfil de Negocio de Google. Reservas directas por WhatsApp sin comisiones de intermediarios.', stats, eyebrow = 'Calificación en el Perfil de Negocio de Google' } = Astro.props;
const resolvedStats = stats ?? [
    { icon: 'hotel', title: `${roomCount} habitaciones`, description: 'Capacidad del alojamiento' },
    { icon: 'location_on', title: location, description: 'Ubicación del alojamiento' },
    { icon: 'handshake', title: 'Reserva directa', description: 'Atención por WhatsApp sin intermediarios' }
];
---

<section class="w-full bg-surface-bright py-3xl lg:py-4xl" id="google-rating-section">
    <div class="mx-auto max-w-[var(--container-site)] px-lg">
        <div class="rounded-ui-3xl bg-surface p-xl shadow-sm md:p-3xl">
            <div class="grid grid-cols-1 items-center gap-xl lg:grid-cols-12 lg:gap-2xl">
                <div class="flex flex-col items-center text-center lg:col-span-5 lg:items-start lg:text-left">
                    <div class="mb-base"><Badge variant="soft" icon="verified" iconTone="amberStrong">{eyebrow}</Badge></div>
                    <div class="mb-xs flex items-baseline gap-sm"><span class="font-heading text-[4rem] font-bold leading-none text-text-primary">{value.toFixed(1)}</span><span class="font-heading text-card-title text-text-secondary">/ 5.0</span></div>
                    <div class="mb-sm"><Rating value={value} size="md" /></div>
                    <p class="font-body text-body-lg font-semibold text-text-primary">Basado en {reviewCount} reseñas verificadas de Google</p>
                    <p class="mt-xs max-w-[360px] font-body text-body text-text-secondary">{description}</p>
                </div>
                <div class="grid grid-cols-1 gap-base sm:grid-cols-3 lg:col-span-7">
                    {resolvedStats.map((stat) => <StatCard {...stat} />)}
                </div>
            </div>
        </div>
    </div>
</section>