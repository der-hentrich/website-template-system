---
import SectionHeader from '../components/SectionHeader.astro';

interface Props {
    eyebrow: string;
    eyebrowIcon?: string;
    title: string;
    description: string;
    paragraphs?: string[];
}

const { eyebrow, eyebrowIcon = 'hotel', title, description, paragraphs = [] } = Astro.props;
---

<section class="w-full bg-surface py-3xl lg:py-4xl" id="about-section">
    <div class="mx-auto max-w-[var(--container-site)] px-lg">
        <div class="grid grid-cols-1 gap-xl lg:grid-cols-12 lg:gap-2xl">
            <div class="lg:col-span-5"><SectionHeader eyebrow={eyebrow} eyebrowIcon={eyebrowIcon} title={title} description={description} badgeVariant="soft" /></div>
            {paragraphs.length > 0 && <div class="space-y-base font-body text-body-lg text-text-secondary lg:col-span-7 lg:pt-xl">{paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>}
        </div>
    </div>
</section>
