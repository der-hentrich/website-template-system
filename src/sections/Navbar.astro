---
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';

interface NavItem {
    label: string;
    href: string;
}

interface Props {
    name: string;
    location: string;
    items: NavItem[];
    whatsappHref: string;
    whatsappLabel?: string;
    lang?: 'es' | 'en';
    languageHref: string;
}

const { name, location, items, whatsappHref, whatsappLabel: whatsappLabelProp, lang = 'es', languageHref } = Astro.props;
const isEnglish = lang === 'en';
const whatsappLabel = whatsappLabelProp ?? (isEnglish ? 'Contact via WhatsApp' : 'Contactar por WhatsApp');
const navigationLabel = isEnglish ? 'Main navigation' : 'Navegación principal';
const mobileNavigationLabel = isEnglish ? 'Mobile navigation' : 'Navegación móvil';
const menuLabel = isEnglish ? 'Open navigation menu' : 'Abrir menú de navegación';
const languageAriaLabel = isEnglish ? 'Cambiar a español' : 'Switch to English';
const languageCode = isEnglish ? 'es' : 'en';
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-border bg-surface/95 backdrop-blur-md transition-all duration-200">
    <div class="mx-auto flex h-20 max-w-[var(--container-site)] items-center justify-between gap-base px-lg">
        <a class="group flex shrink-0 flex-col" href="#top">
            <span class="whitespace-nowrap font-heading text-card-title tracking-tight text-text-primary transition-colors group-hover:text-primary-container">{name}</span>
            <span class="-mt-1 whitespace-nowrap text-[11px] font-medium uppercase tracking-wider text-text-secondary">{location}</span>
        </a>

        <nav class="hidden items-center gap-base lg:flex" aria-label={navigationLabel}>
            {items.map((item) => <a class="px-sm py-xs font-body text-label text-on-surface-variant transition-colors hover:text-on-surface" href={item.href}>{item.label}</a>)}
        </nav>

        <div class="flex shrink-0 items-center gap-sm">
            <a class="inline-flex h-11 w-11 shrink-0 items-center justify-center" href={languageHref} hreflang={languageCode} aria-label={languageAriaLabel}>
                {isEnglish ? (
                        <svg class="w-9 overflow-hidden rounded-[3px] transition-opacity hover:opacity-75" viewBox="0 0 60 36" aria-hidden="true">
                            <rect width="60" height="36" fill="#012169" />
                            <path d="M0 0L60 36M60 0L0 36" stroke="#fff" stroke-width="7.2" />
                            <path d="M0 0L60 36M60 0L0 36" stroke="#C8102E" stroke-width="4.2" />
                            <path d="M30 0V36M0 18H60" stroke="#fff" stroke-width="12" />
                            <path d="M30 0V36M0 18H60" stroke="#C8102E" stroke-width="7.2" />
                        </svg>
                ) : (
                        <svg class="w-9 overflow-hidden rounded-[3px] transition-opacity hover:opacity-75" viewBox="0 0 3 2" aria-hidden="true">
                            <rect width="3" height="1" fill="#FCD116" />
                            <rect y="1" width="3" height="0.5" fill="#003893" />
                            <rect y="1.5" width="3" height="0.5" fill="#CE1126" />
                        </svg>
                )}
            </a>

            <Button variant="whatsapp" size="sm" href={whatsappHref} target="_blank" rel="noopener noreferrer" icon="chat" ariaLabel={whatsappLabel}>
                <span class="hidden whitespace-nowrap lg:inline">{whatsappLabel}</span>
            </Button>

            <details class="group relative lg:hidden">
                <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-ui-sm bg-surface text-primary-container shadow-sm transition-colors hover:bg-surface-container" aria-label={menuLabel}>
                    <span class="group-open:hidden"><Icon name="menu" size="lg" tone="primary" /></span>
                    <span class="hidden group-open:inline-flex"><Icon name="close" size="lg" tone="primary" /></span>
                </summary>

                <nav class="absolute right-0 top-[calc(100%+8px)] w-64 overflow-hidden rounded-ui-md border border-border bg-surface p-sm shadow-lg" aria-label={mobileNavigationLabel}>
                    {items.map((item) => <a class="block rounded-ui-sm px-base py-md font-body text-label text-on-surface-variant transition-colors hover:bg-surface-container hover:text-on-surface" href={item.href}>{item.label}</a>)}
                </nav>
            </details>
        </div>
    </div>
</header>