---
import Badge from './Badge.astro';

type HeaderWidth = 'narrow' | 'default';
type BadgeVariant = 'surface' | 'soft' | 'dark';
type HeaderTone = 'default' | 'inverse';
type HeaderSpacing = 'default' | 'compact';

interface Props {
    eyebrow: string;
    eyebrowIcon?: string;
    title: string;
    description?: string;
    width?: HeaderWidth;
    badgeVariant?: BadgeVariant;
    tone?: HeaderTone;
    spacing?: HeaderSpacing;
}

const { eyebrow, eyebrowIcon, title, description, width = 'default', badgeVariant = 'surface', tone = 'default', spacing = 'default' } = Astro.props;
const widthClasses: Record<HeaderWidth, string> = { narrow: 'max-w-[640px]', default: 'max-w-[680px]' };
const hasAside = Astro.slots.has('aside');
---

<header class:list={[spacing === 'compact' ? 'mb-lg' : 'mb-2xl', 'gap-base', hasAside ? 'flex flex-col justify-between md:flex-row md:items-end' : widthClasses[width]]}>
    <div class={hasAside ? widthClasses[width] : undefined}>
        <div class="mb-sm"><Badge variant={badgeVariant} icon={eyebrowIcon} iconTone="primary">{eyebrow}</Badge></div>
        <h2 class:list={['font-heading text-section-title tracking-tight', tone === 'inverse' ? 'text-on-primary' : 'text-text-primary']}>{title}</h2>
        {description && <p class:list={['mt-xs font-body text-body-lg', tone === 'inverse' ? 'text-primary-fixed' : 'text-text-secondary']}>{description}</p>}
    </div>
    {hasAside && <div class="self-start md:self-auto"><slot name="aside" /></div>}
</header>
