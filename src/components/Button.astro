---
import Icon from './Icon.astro';

type ButtonVariant = 'primary' | 'secondary' | 'whatsapp';
type ButtonSize = 'sm' | 'md' | 'lg' | 'xl';
type ButtonTarget = '_self' | '_blank' | '_parent' | '_top';
type ButtonIconPosition = 'start' | 'end';

interface Props {
    variant?: ButtonVariant;
    size?: ButtonSize;
    href?: string;
    target?: ButtonTarget;
    rel?: string;
    type?: 'button' | 'submit' | 'reset';
    icon?: string;
    iconPosition?: ButtonIconPosition;
    block?: boolean;
    disabled?: boolean;
    ariaLabel?: string;
}

const { variant = 'primary', size = 'lg', href, target, rel, type = 'button', icon, iconPosition = 'start', block = false, disabled = false, ariaLabel } = Astro.props;
const baseClasses = 'inline-flex items-center justify-center rounded-ui-sm font-body text-button shadow-sm transition-all';
const variantClasses: Record<ButtonVariant, string> = {
    primary: 'bg-primary text-on-primary hover:bg-primary-strong',
    secondary: 'bg-surface text-primary-container hover:bg-surface-container',
    whatsapp: 'bg-whatsapp text-on-whatsapp hover:bg-whatsapp-hover'
};
const sizeClasses: Record<ButtonSize, string> = { sm: 'h-[44px] px-[18px]', md: 'h-[46px] px-[22px]', lg: 'h-[48px] px-[24px]', xl: 'h-[50px] px-[24px]' };
const gapClass = variant === 'secondary' || (variant === 'whatsapp' && size === 'md') ? 'gap-xs' : 'gap-sm';
const sizeClass = variant === 'secondary' && size === 'lg' ? 'h-[48px] px-[22px]' : sizeClasses[size];
const iconSize = variant === 'secondary' ? 'sm' : 'md';
const classes = [baseClasses, variantClasses[variant], gapClass, sizeClass, block && 'w-full', disabled && 'pointer-events-none opacity-50'];
---

{href ? (
<a class:list={classes} href={href} target={target} rel={rel} aria-label={ariaLabel} aria-disabled={disabled ? 'true' : undefined}>
    {variant === 'whatsapp' ? (
            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.04 2a9.84 9.84 0 0 0-8.43 14.91L2 22l5.22-1.57A9.86 9.86 0 1 0 12.04 2Zm0 17.75a7.86 7.86 0 0 1-4.01-1.1l-.29-.17-3.1.93.96-3.02-.19-.31a7.83 7.83 0 1 1 6.63 3.67Zm4.3-5.87c-.24-.12-1.4-.69-1.62-.77-.22-.08-.38-.12-.54.12-.16.24-.62.77-.76.93-.14.16-.28.18-.52.06-.24-.12-1-.37-1.91-1.18a7.18 7.18 0 0 1-1.32-1.64c-.14-.24-.01-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.19-.47-.39-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.1 3.62.57.25 1.02.39 1.37.5.58.18 1.1.16 1.51.1.46-.07 1.4-.57 1.6-1.12.2-.55.2-1.02.14-1.12-.06-.1-.22-.16-.46-.28Z" />
            </svg>
    ) : (
        icon && iconPosition === 'start' && <Icon name={icon} size={iconSize} />
    )}
    <slot />
    {variant !== 'whatsapp' && icon && iconPosition === 'end' && <Icon name={icon} size={iconSize} />}
</a>
    ) : (
<button class:list={classes} type={type} disabled={disabled} aria-label={ariaLabel}>
    {variant === 'whatsapp' ? (
            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.04 2a9.84 9.84 0 0 0-8.43 14.91L2 22l5.22-1.57A9.86 9.86 0 1 0 12.04 2Zm0 17.75a7.86 7.86 0 0 1-4.01-1.1l-.29-.17-3.1.93.96-3.02-.19-.31a7.83 7.83 0 1 1 6.63 3.67Zm4.3-5.87c-.24-.12-1.4-.69-1.62-.77-.22-.08-.38-.12-.54.12-.16.24-.62.77-.76.93-.14.16-.28.18-.52.06-.24-.12-1-.37-1.91-1.18a7.18 7.18 0 0 1-1.32-1.64c-.14-.24-.01-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.19-.47-.39-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.1 3.62.57.25 1.02.39 1.37.5.58.18 1.1.16 1.51.1.46-.07 1.4-.57 1.6-1.12.2-.55.2-1.02.14-1.12-.06-.1-.22-.16-.46-.28Z" />
            </svg>
    ) : (
        icon && iconPosition === 'start' && <Icon name={icon} size={iconSize} />
    )}
    <slot />
    {variant !== 'whatsapp' && icon && iconPosition === 'end' && <Icon name={icon} size={iconSize} />}
</button>
    )}
