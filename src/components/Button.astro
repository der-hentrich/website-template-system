---
import Icon from './Icon.astro';

type ButtonVariant = 'primary' | 'secondary' | 'whatsapp' | 'filter';
type ButtonSize = 'xs' | 'sm' | 'md' | 'lg' | 'xl' | 'content';
type ButtonTarget = '_self' | '_blank' | '_parent' | '_top';
type ButtonIconPosition = 'start' | 'end';
type ButtonShape = 'pill' | 'circle';

interface Props {
    variant?: ButtonVariant;
    size?: ButtonSize;
    href?: string;
    target?: ButtonTarget;
    rel?: string;
    type?: 'button' | 'submit' | 'reset';
    icon?: string;
    iconPosition?: ButtonIconPosition;
    block?: boolean;
    disabled?: boolean;
    ariaLabel?: string;
    pressed?: boolean;
    dataCategory?: string;
    shape?: ButtonShape;
    class?: string;
    id?: string;
    ariaControls?: string;
    expanded?: boolean;
    dataHsCollapse?: string;
    hreflang?: string;
}

const { variant = 'primary', size = 'lg', href, target, rel, type = 'button', icon, iconPosition = 'start', block = false, disabled = false, ariaLabel, pressed, dataCategory, shape = 'pill', class: className, id, ariaControls, expanded, dataHsCollapse, hreflang } = Astro.props;
const baseClasses = 'inline-flex items-center justify-center rounded-ui-sm font-body text-button shadow-sm transition-[transform,background-color,color,box-shadow] duration-200 ease-out hover:-translate-y-px hover:shadow-md active:translate-y-0 active:shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30 focus-visible:ring-offset-2 motion-reduce:transform-none motion-reduce:transition-none';
const variantClasses: Record<ButtonVariant, string> = {
    primary: 'bg-primary text-on-primary hover:bg-primary-strong',
    secondary: 'border-2 border-primary bg-surface text-primary hover:border-primary hover:bg-primary hover:text-on-primary active:border-primary-strong active:bg-primary-strong active:text-on-primary focus-visible:ring-primary focus-visible:ring-offset-surface',
    whatsapp: 'bg-whatsapp text-on-whatsapp hover:bg-whatsapp-hover',
    filter: 'button-filter border border-outline-variant bg-surface-alt text-text-secondary hover:text-text-primary'
};
const sizeClasses: Record<ButtonSize, string> = { xs: 'h-8 px-base text-[12px]', sm: 'h-[44px] px-[18px]', md: 'h-[46px] px-[22px]', lg: 'h-[48px] px-[24px]', xl: 'h-[50px] px-[24px]', content: 'min-h-[46px] px-[22px] py-md text-[14px] leading-snug' };
const circleSizeClasses: Record<ButtonSize, string> = { xs: 'h-9 w-9 p-0', sm: 'h-11 w-11 p-0', md: 'h-12 w-12 p-0', lg: 'h-[52px] w-[52px] p-0', xl: 'h-14 w-14 p-0', content: 'h-12 w-12 p-0' };
const gapClass = variant === 'secondary' || (variant === 'whatsapp' && size === 'md') ? 'gap-xs' : 'gap-sm';
const sizeClass = variant === 'secondary' && size === 'lg' ? 'h-[48px] px-[22px]' : sizeClasses[size];
const iconSize = variant === 'secondary' ? 'sm' : 'md';
const classes = [baseClasses, variantClasses[variant], gapClass, shape === 'circle' ? circleSizeClasses[size] : sizeClass, block && 'w-full', disabled && 'pointer-events-none opacity-50', className];
---

{href ? (
    <a id={id} class:list={classes} href={href} target={target} rel={rel} hreflang={hreflang} aria-label={ariaLabel} aria-disabled={disabled ? 'true' : undefined}>
        {variant === 'whatsapp' ? (
            <Icon name="whatsapp" size={shape === 'circle' ? 'xl' : 'md'} tone="inverse" />
        ) : (
            icon && iconPosition === 'start' && <Icon name={icon} size={iconSize} />
        )}
        <slot />
        {variant !== 'whatsapp' && icon && iconPosition === 'end' && <Icon name={icon} size={iconSize} />}
    </a>
) : (
    <button id={id} class:list={classes} type={type} disabled={disabled} aria-label={ariaLabel} aria-pressed={pressed} aria-expanded={expanded} aria-controls={ariaControls} data-category={dataCategory} data-hs-collapse={dataHsCollapse}>
        {variant === 'whatsapp' ? (
            <Icon name="whatsapp" size={shape === 'circle' ? 'xl' : 'md'} tone="inverse" />
        ) : (
            icon && iconPosition === 'start' && <Icon name={icon} size={iconSize} />
        )}
        <slot />
        {variant !== 'whatsapp' && icon && iconPosition === 'end' && <Icon name={icon} size={iconSize} />}
    </button>
)}

<style>
    .button-filter[aria-pressed='true'] {
        border-color: var(--color-primary);
        background: var(--color-primary);
        color: var(--color-on-primary);
    }
</style>
