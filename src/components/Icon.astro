---
type IconSize = 'xs' | 'sm' | 'md' | 'lg' | 'xl' | '2xl';
type IconTone = 'current' | 'primary' | 'primaryFixed' | 'secondary' | 'inverse' | 'whatsapp' | 'amber' | 'amberStrong' | 'muted';

interface Props {
    name: string;
    size?: IconSize;
    tone?: IconTone;
    filled?: boolean;
    label?: string;
}

const { name, size = 'md', tone = 'current', filled = false, label } = Astro.props;
const sizeValues: Record<IconSize, number> = { xs: 16, sm: 18, md: 20, lg: 24, xl: 26, '2xl': 28 };
const toneClasses: Record<IconTone, string> = { current: 'text-current', primary: 'text-primary-container', primaryFixed: 'text-primary-fixed', secondary: 'text-text-secondary', inverse: 'text-on-primary', whatsapp: 'text-whatsapp', amber: 'text-amber-500', amberStrong: 'text-amber-600', muted: 'text-outline-variant' };
const iconStyle = `font-size:${sizeValues[size]}px;line-height:1;font-variation-settings:'FILL' ${filled ? 1 : 0},'wght' 400,'GRAD' 0,'opsz' 24;`;
const isWhatsapp = name === 'whatsapp';
---

{isWhatsapp ? (
    <svg class:list={['inline-block shrink-0', toneClasses[tone]]} style={`width:${sizeValues[size]}px;height:${sizeValues[size]}px`} viewBox="0 0 24 24" fill="currentColor" role={label ? 'img' : undefined} aria-hidden={label ? undefined : 'true'} aria-label={label}>
        <path d="M12.04 2a9.84 9.84 0 0 0-8.43 14.91L2 22l5.22-1.57A9.86 9.86 0 1 0 12.04 2Zm0 17.75a7.86 7.86 0 0 1-4.01-1.1l-.29-.17-3.1.93.96-3.02-.19-.31a7.83 7.83 0 1 1 6.63 3.67Zm4.3-5.87c-.24-.12-1.4-.69-1.62-.77-.22-.08-.38-.12-.54.12-.16.24-.62.77-.76.93-.14.16-.28.18-.52.06-.24-.12-1-.37-1.91-1.18a7.18 7.18 0 0 1-1.32-1.64c-.14-.24-.01-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.19-.47-.39-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.1 3.62.57.25 1.02.39 1.37.5.58.18 1.1.16 1.51.1.46-.07 1.4-.57 1.6-1.12.2-.55.2-1.02.14-1.12-.06-.1-.22-.16-.46-.28Z" />
    </svg>
) : (
    <span class:list={['material-symbols-outlined', toneClasses[tone]]} style={iconStyle} aria-hidden={label ? undefined : 'true'} aria-label={label}>{name}</span>
)}
