---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Card from './Card.astro';

interface Props {
    image: ImageMetadata;
    imageAlt: string;
    caption?: string;
    variant?: 'caption' | 'editorial';
    category?: string;
    eyebrow?: string;
    title?: string;
    description?: string;
}

const { image, imageAlt, caption, variant = 'caption', category, eyebrow, title, description } = Astro.props;
const editorial = variant === 'editorial';
---

<div class:list={['group', editorial && 'gallery-item']} data-category={category}>
    <Card variant="media" radius="lg" shadow="sm" padding="none" overflow="hidden">
        <div class:list={['relative overflow-hidden', editorial ? 'aspect-[3/4]' : 'aspect-[4/3]']}>
            <Image class:list={['h-full w-full object-cover ease-out group-hover:scale-[1.02] motion-reduce:transform-none motion-reduce:transition-none', editorial ? 'transition-transform duration-700' : 'transition-transform duration-500']} src={image} alt={imageAlt} />
            {editorial ? (
                <div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-inverse-surface/85 via-transparent to-transparent p-lg text-white">
                    {eyebrow && <span class="font-body text-[11px] font-semibold uppercase tracking-[0.12em] text-primary-fixed">{eyebrow}</span>}
                    {title && <h3 class="font-heading text-[21px] text-white">{title}</h3>}
                    {description && <p class="font-body text-[13px] leading-relaxed text-white/80">{description}</p>}
                </div>
            ) : (
                <div class="absolute inset-0 flex items-end bg-gradient-to-t from-primary-strong/70 via-transparent to-transparent p-base opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-100 motion-reduce:transition-none">
                    {caption && <span class="font-body text-label text-on-primary">{caption}</span>}
                </div>
            )}
        </div>
    </Card>
</div>
