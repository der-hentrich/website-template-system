---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Card from './Card.astro';

interface Props {
    image: ImageMetadata;
    imageAlt: string;
    caption: string;
}

const { image, imageAlt, caption } = Astro.props;
---

<div class="group">
    <Card variant="media" radius="lg" shadow="sm" padding="none" overflow="hidden">
        <div class="relative aspect-[4/3] overflow-hidden">
            <Image class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02] motion-reduce:transform-none motion-reduce:transition-none" src={image} alt={imageAlt} />
            <div class="absolute inset-0 flex items-end bg-gradient-to-t from-primary-strong/70 via-transparent to-transparent p-base opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-100 motion-reduce:transition-none">
                <span class="font-body text-label text-on-primary">{caption}</span>
            </div>
        </div>
    </Card>
</div>