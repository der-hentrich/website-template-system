---
import './global.css';

interface Props {
    lang?: 'es' | 'en';
    title: string;
    description: string;
    noIndex?: boolean;
}

const { lang = 'es', title, description, noIndex = false } = Astro.props;
const site = Astro.site;
const currentPath = Astro.url.pathname;
const spanishPath = currentPath.replace(/^\/(?:es|en)(?=\/|$)/, '/es');
const englishPath = currentPath.replace(/^\/(?:es|en)(?=\/|$)/, '/en');
const canonicalUrl = site ? new URL(currentPath, site).href : undefined;
const spanishUrl = site ? new URL(spanishPath, site).href : undefined;
const englishUrl = site ? new URL(englishPath, site).href : undefined;
const robots = noIndex || !site ? 'noindex, nofollow' : 'index, follow';
---

<!doctype html>
<html lang={lang}>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {site && !noIndex && <Fragment>
        <link rel="alternate" hreflang="es-CO" href={spanishUrl} />
        <link rel="alternate" hreflang="en" href={englishUrl} />
        <link rel="alternate" hreflang="x-default" href={spanishUrl} />
        <link rel="sitemap" href={new URL('/sitemap.xml', site).href} />
    </Fragment>}
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Manrope:wght@600;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <slot name="head" />
</head>
<body class="min-h-screen bg-surface-container-low font-body text-text-primary antialiased">
<slot />

<script>
    import './preline.ts';
    import './reveal.ts';
</script>
</body>
</html>